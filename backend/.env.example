DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
LLM_PROVIDER_MODE=mock
CODE_EXECUTOR_BACKEND=disabled
CONTEXT_FILE_MAX_BYTES=5242880
RUN_CONTEXT_MAX_CHARS=200000
PDF_MAX_PAGES=100
TOOL_MAX_ROUNDS=8
TOOL_MAX_CALLS=16
TOOL_OUTPUT_MAX_CHARS=20000
TOOL_TIMEOUT=30
TAVILY_SEARCH_URL=https://api.tavily.com/search
CODE_EXECUTOR_IMAGE=python:3.14-slim
CODE_EXECUTOR_MEMORY=128m
CODE_EXECUTOR_CPUS=0.5
CODE_EXECUTOR_PIDS=64
CODE_EXECUTOR_WORKSPACE_BYTES=16777216
# Optional total usage threshold including planning; unset means no run budget.
# RUN_TOKEN_BUDGET=50000
MAX_PARALLEL_STEPS=4
WORKER_JOB_TIMEOUT=600
LLM_REQUEST_TIMEOUT=60
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
