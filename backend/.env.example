DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/orchestrator
REDIS_URL=redis://127.0.0.1:16379/0
LOG_LEVEL=INFO
# auto: colored console on a terminal, JSON when redirected. Also accepts console/json.
WORKER_LOG_FORMAT=auto
# auto respects NO_COLOR. Use always/never to override terminal color detection.
WORKER_LOG_COLORS=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
TAVILY_API_KEY=
LLM_PROVIDER_MODE=mock
# Real mode discovers models with each configured API key; mock uses local fixtures.
ANTHROPIC_API_URL=https://api.anthropic.com/v1
OPENAI_API_URL=https://api.openai.com/v1
MODEL_DISCOVERY_CACHE_SECONDS=300
MODEL_DISCOVERY_ERROR_CACHE_SECONDS=30
MODEL_DISCOVERY_TIMEOUT=15
MODEL_DISCOVERY_MAX_PAGES=100
# Initial selections; in real mode choose exact discovered IDs in Settings.
PLANNER_MODEL=claude-sonnet
DEFAULT_AGENT_MODEL=claude-sonnet
# Demo launcher sets this automatically and uses isolated PostgreSQL/Redis.
DEMO_MODE=false
MOCK_STREAM_CHUNK_CHARS=12
MOCK_STREAM_DELAY=0.2
CODE_EXECUTOR_BACKEND=disabled
CONTEXT_FILE_MAX_BYTES=5242880
RUN_CONTEXT_MAX_CHARS=200000
PDF_MAX_PAGES=100
TOOL_MAX_ROUNDS=8
TOOL_MAX_CALLS=16
TOOL_OUTPUT_MAX_CHARS=20000
TOOL_TIMEOUT=30
TAVILY_SEARCH_URL=https://api.tavily.com/search
CODE_EXECUTOR_IMAGE=python:3.14-slim
CODE_EXECUTOR_MEMORY=128m
CODE_EXECUTOR_CPUS=0.5
CODE_EXECUTOR_PIDS=64
CODE_EXECUTOR_WORKSPACE_BYTES=16777216
# Optional total usage threshold including planning; unset means no run budget.
# RUN_TOKEN_BUDGET=50000
MAX_PARALLEL_STEPS=4
WORKER_JOB_TIMEOUT=600
RECOVERY_BATCH_SIZE=100
CLEANUP_BATCH_SIZE=100
UNUSED_FILE_RETENTION_DAYS=7
TERMINAL_EVENT_RETENTION_DAYS=30
# Use a distinct scope for each deployment sharing a Docker daemon.
CODE_EXECUTOR_SCOPE=local
CODE_EXECUTOR_ORPHAN_AGE_SECONDS=3600
CLEANUP_DOCKER_TIMEOUT=10
LLM_REQUEST_TIMEOUT=60
CONTEXT_SAFETY_MARGIN_TOKENS=256
OPENAI_ENCODING=o200k_base
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
